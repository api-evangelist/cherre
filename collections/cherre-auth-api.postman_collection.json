          "id": "a4638530-2e46-4e73-a0ad-b4e61d954f26",
          "name": "Obtain an OAuth 2.0 client-credentials access token.",
          "request": {
            "name": "Obtain an OAuth 2.0 client-credentials access token.",
            "description": {
              "content": "Exchange client credentials for a short-lived bearer access token used to authorize GraphQL requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"<string>\",\n  \"client_id\": \"<string>\",\n  \"client_secret\": \"<string>\",\n  \"audience\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "c917c03a-86ef-4ef9-883d-ce6b64fd5411",
              "name": "Access token issued.",
              "originalRequest": {
                "url": {
                  "path": [
                    "oauth",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
